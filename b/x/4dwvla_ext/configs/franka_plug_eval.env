# Franka plug-into-socket evaluation: hardware/task-specific overrides.
#
# Source this before starting the Franky-container client so operators can
# recalibrate without touching franky_controller_direct.py:
#
#   source /workspace/RLinf/b/x/4dwvla_ext/configs/franka_plug_eval.env
#   python /workspace/RLinf/b/x/4dwvla_ext/franka_vla_client.py ...
#
# See b/d/frk1/grperr_1.md §4 修复 D for the full analysis. Summary: the
# demonstration data closes the gripper to <1mm width 87% of the time
# (mean 2.6mm) -- essentially fully closed -- but the grasp-verification
# window pinned by _ensure_plug_gripper_env() in franky_controller_direct.py
# defaults to 15mm +/-10mm (i.e. accepts [5mm, 25mm]). If the real robot
# closes on the plug the same way the demos do, FrankaLibfrankaGripper.close()
# will treat the grasp as failed (measured width falls outside the window)
# and gripper_holding() will always report False.
#
# ACTION REQUIRED before trusting this file's defaults: measure the plug's
# actual thickness along the gripper's closing axis with calipers and set
# FRANKA_CUBE_WIDTH_M to that measurement (+/- FRANKA_HOLD_TOL_M). Until then
# these are left at the pre-existing code defaults (unchanged behavior) --
# this file only gives you one place to override them instead of editing
# franky_controller_direct.py's _ensure_plug_gripper_env().

# ── Hardware/tooling (changes with robot and finger tips) ────────────────
# Phase 1a caliper measurement (2026-09-18): plug thickness = 10 mm.
# Window [0.002, 0.018] excludes empty-closed (~0 mm) but includes the plug.
export FRANKA_CUBE_WIDTH_M=0.008
export FRANKA_HOLD_TOL_M=0.004
export FRANKA_GRASP_FORCE=20
# Ceiling for the commanded width, in libfranka's REPORTED units -- NOT the
# caliper-measured finger gap. Phase 1b (2026-09-18) found these disagree:
# the caliper reads 80 mm at full open while the hand reports 66.4 mm, i.e.
# the homing offset is stale (grperr_1.2.md Q1). Setting the physical 0.080
# here let approach-phase commands (w_cmd = 0.0773) escape the clamp, so the
# continuous mode issued a blocking "open wider" command every control step
# that the hand could never satisfy -- fingers buzzing at their limit, loop
# rate 3.58 -> 2.28 Hz. Run dsplug/gripper_homing.py; if homing restores a
# ~0.080 reported max, update this to the new reported value.
# 2026-09-22 startup: the hand reports max_width=0.0803 and width=0.0802, so
# the stale 0.066 ceiling would turn a "stay open" command into a 14 mm close.
export FRANKA_GRIPPER_MAX_WIDTH_M=0.080
# export FRANKA_DYNAMICS_FACTOR=0.2       # Phase 4a: >0.2 requires §15.7 validation

# ── Cameras (修复 F, grperr_1.md R6, confirmed 2026-09-18) ──────────────
export RS_GLOBAL_SERIAL=250222073513
export RS_WRIST_SERIAL=420122070525

# ── Gripper execution semantics (grperr_1.2.md Phase 2) ─────────────────
export VLA_GRIPPER_MODE=continuous       # binary_abs | binary_delta | continuous
export VLA_GRIPPER_DEADBAND_M=0.0015     # continuous mode: narrowing dead zone
export VLA_GRIPPER_WIDEN_DEADBAND_M=0.006  # continuous mode: widening dead zone
export VLA_GRIPPER_CLOSE_DELTA_M=0.001   # binary_delta mode: close trigger threshold
export VLA_GRIPPER_OPEN_DELTA_M=0.004    # binary_delta mode: open hysteresis threshold
export VLA_GRIPPER_GRASP_HANDOFF_A=0.40  # a above this switches to force-control grasp
# Retry a missed grasp at most once per second. is_open() is not the gate:
# the ramp legitimately narrows below 60 mm before a>=0.8.
export VLA_GRASP_RETRY_COOLDOWN_S=1.0
# Backward compat (binary_abs mode only)
export VLA_GRIPPER_CLOSE_THRESHOLD=0.4
export VLA_GRIPPER_CLOSE_IF_ABOVE=1
