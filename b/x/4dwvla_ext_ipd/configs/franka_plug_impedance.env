# Joint-impedance overrides for the 4DWVLA plug eval.
# Source the waypoint-client hardware file first, then this file:
#
#   source /workspace/RLinf/b/x/4dwvla_ext/configs/franka_plug_eval.env
#   source /workspace/RLinf/b/x/4dwvla_ext_ipd/configs/franka_plug_impedance.env
#
# Gains are the 7 joint values used by FrankyController
# (rlinf/envs/realworld/franka/franky_controller.py). Units: stiffness N.m/rad,
# damping N.m.s/rad. Leave them unset to use those defaults from code.
# A different robot or a stiffer contact task should get its own file rather
# than an edit to joint_impedance_controller.py.
#
# q5/q6 doubled, q7 quadrupled versus FrankyController. See impedance_gains.py.
export VLA_IPD_STIFFNESS=103.75,265.734,227.273,221.445,27,25.6,20.5
export VLA_IPD_DAMPING=16.7,40.263,25.0,12.862,2.12,2.83,2.66
export VLA_IPD_COMPENSATE_CORIOLIS=1
